{
  "name": "zonefix-africa-mvp",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "db:push": "npm run db:push --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
